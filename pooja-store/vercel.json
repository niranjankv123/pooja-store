{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/apps/server/index.ts"
        },
        {
            "source": "/(.*)\\.(.*)",
            "destination": "/apps/client/dist/$1.$2"
        },
        {
            "source": "/(.*)",
            "destination": "/apps/client/dist/index.html"
        }
    ],
    "functions": {
        "apps/server/index.ts": {
            "includeFiles": "apps/server/public/**",
            "maxDuration": 10
        }
    }
}