{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/apps/server/index.ts"
        },
        {
            "source": "/((?!api/.*).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "apps/server/index.ts": {
            "includeFiles": "apps/server/public/**",
            "maxDuration": 10
        }
    }
}